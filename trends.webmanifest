{
  "name": "데일리 트렌드 뷰어",
  "short_name": "트렌드",
  "description": "유튜브·구글 트렌드·뉴스·커뮤니티에서 매일 모은 오늘의 트렌드",
  "lang": "ko",
  "dir": "ltr",
  "start_url": "./trends.html",
  "scope": "./",
  "id": "./trends.html",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "background_color": "#f4f6fa",
  "theme_color": "#f6f7fb",
  "orientation": "any",
  "icons": [
    { "src": "./assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./assets/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "./assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "유튜브 트렌드", "url": "./trends.html#youtube" },
    { "name": "구글 트렌드", "url": "./trends.html#google" }
  ]
}
